# --- Secrets (never commit) ---
.env
.env.*
!.env.example

# --- CasaOS local deployment artifacts (may contain credentials) ---
deploy/casaos/docker-compose.generated.yml
deploy/casaos/.generated-password

# --- Impeccable process artifacts (decision mocks, payloads); briefs stay tracked ---
.impeccable/*
!.impeccable/surfaces/

# --- Transfer bundle (build artifact) ---
/autoshorts-studio-src.zip

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/node_modules/
*.tsbuildinfo

# --- Media pipeline working data (runtime, not source) ---
media/
media_cache/
media_out/
*.mp4
*.mkv
*.webm
*.mov
*.part
*.tmp

# --- Logs / runtime ---
*.log
logs/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
