# Autonomous Creator Studio — environment template
# Copy to .env and fill in real values. NEVER commit the real .env.
# Deployment is blocked until the security gates in docs/SECURITY.md are
# confirmed (GitHub token revoked, PostgreSQL password rotated).

# --- Application ---
# development | production
APP_ENV=development
# debug | info | warning | error
LOG_LEVEL=info

# --- Database ---
# Full SQLAlchemy async URL. On the Pi (docker compose) this is built from
# the POSTGRES_* values below; the compose file sets it automatically.
# Local example (PostgreSQL): postgresql+asyncpg://autoshorts:CHANGE_ME@localhost:5432/autoshorts_studio
# Local example (tests): sqlite+aiosqlite:///:memory:
DATABASE_URL=

# Used by deploy/docker-compose.yml to provision the postgres container.
# Generate a fresh password at deployment time (never reuse old ones).
POSTGRES_USER=autoshorts
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_FRESH
POSTGRES_DB=autoshorts_studio

# --- Future integrations (added in later milestones; keep empty for now) ---
# YouTube Data API v3 OAuth (Milestone 3): YOUTUBE_CLIENT_ID / YOUTUBE_CLIENT_SECRET
# LLM providers (Milestone 5): LLM_MAIN_API_KEY / LLM_FALLBACK1_API_KEY / LLM_FALLBACK2_API_KEY
